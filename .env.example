# Every variable the app reads. Fake values only; real ones live in the Railway service variables
# or in the process environment of the on-prem server (NSSM service / iniciar*.bat).
# Note: besides the monitoring variables, the app only reads DATABASE_URL from a local .env file
# (engine/cuentas.py); everything else must be in the process environment.

# Access (engine/acceso.py, engine/seguridad.py). Without APP_PASSWORD only the machine itself (loopback, no
# proxy headers) is served; everything else gets 503. Required on every deploy reached over the network.
APP_PASSWORD=
# Signs the session cookie (derived from APP_PASSWORD when empty). Changing either one ends every session.
# SESSION_SECRET=
# Optional: idle session hours (12), absolute cap in days (7), extra origins accepted on POST/PUT/DELETE.
# SESION_HORAS=12
# SESION_MAX_DIAS=7
# ORIGENES_PERMITIDOS=https://hub.example.com
# Optional: how the client IP is read for the sign-in limit: railway | cloudflare | none (autodetected).
# PROXY_MODE=railway
# The hub's key (same value as in the hub): signs the X-Orbit-* identity the hub forwards (signed requests
# need no password) and decrypts FBS passwords the hub stores encrypted ("v1:..."). 32 bytes, base64.
# HUB_CLAVE=
# HUB_CLAVE_ANTERIOR=
# Optional: a signing key of its own instead of the one derived from HUB_CLAVE, and the signature tolerance (s).
# HUB_FIRMA_CLAVE=
# ORBIT_FIRMA_CLAVE=
# ORBIT_FIRMA_TOLERANCIA=60

# The hub's shared Postgres (tables marcas, cuentas_bancarias, fbs_conexiones), read-only.
# Without it the bank accounts come from datos/cuentas_nave.json (or the seed file below) and
# the FBS connections from the manual setup in datos/fbs_sql.json.
DATABASE_URL=postgresql://usuario:clave@host:5432/hub

# Anthropic API key for the AI suggestions and the "why is this entry pending" analysis (optional).
ANTHROPIC_API_KEY=
# Optional: Anthropic token instead of ANTHROPIC_API_KEY (the SDK reads either one).
# ANTHROPIC_AUTH_TOKEN=
# Daily cap of AI analysis calls (POST /api/analizar). Default 150.
# ANALISIS_MAX_DIA=150
# Daily token budget for every AI call (default 2000000; 0 turns AI off), log warning threshold in %, models.
# IA_TOKENS_DIA=2000000
# IA_AVISO_PORCENTAJE=80
# IA_MODELO=claude-sonnet-5
# IA_MODELO_ANALISIS=claude-haiku-4-5

# Optional: fallback bank account seed (format: config/cuentas_semilla.example.json). Default
# config/cuentas_semilla.json (git-ignored: real account numbers).
# CUENTAS_SEMILLA_RUTA=config/cuentas_semilla.json

# Demo environment (separate Railway service): simulated FBS and generated statements for the hub's accounts
# (engine/simulacion.py, needs requirements-demo.txt), "reset demo". Never on a real service.
# DEMO_MODE=true

# Optional: direct FBS (SQL Server) connection when the hub has none configured. Overrides datos/fbs_sql.json.
# FBS_SQL_SERVIDOR=HOST\SQLEXPRESS
# FBS_SQL_PUERTO=1433
# FBS_SQL_BASE=FBS
# FBS_SQL_USUARIO=lector
# FBS_SQL_CLAVE=
# Optional: force the SQL Server driver (pyodbc | pymssql). Default: auto (pyodbc first).
# FBS_SQL_DRIVER=pyodbc
# Optional: TDS version for FreeTDS/pymssql (7.0 / 7.2 / 7.4).
# FBS_SQL_TDS=7.4
# Optional: who may change the manual FBS destination (only the machine itself by default), extra allowed hosts
# beyond private addresses (names, IPs or CIDR), and accepting an FBS login with write roles (not recommended).
# FBS_SQL_EDITABLE=1
# FBS_SQL_HOSTS_PERMITIDOS=127.0.0.1
# FBS_SQL_PERMITIR_LOGIN_ESCRITURA=1

# Port. Railway injects it; when set, `python app.py` listens on 0.0.0.0, otherwise on 127.0.0.1:8765.
# PORT=8765

# Monitoring (engine/telemetria.py, a copy of the monitor repo): without the license key it sends nothing.
NEW_RELIC_LICENSE_KEY=
MONITOR_GRUPO=nave-motors
# Optional monitoring settings (see engine/telemetria.py): NEW_RELIC_REGION, MONITOR_ACTIVO, MONITOR_ENTORNO,
# MONITOR_DESPLIEGUE, MONITOR_INTERVALO, MONITOR_MUESTREO, MONITOR_NIVEL_LOGS,
# OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS
# Read, never set by hand: RAILWAY_ENVIRONMENT, RAILWAY_PROJECT_ID, RAILWAY_GIT_BRANCH, RAILWAY_GIT_COMMIT_SHA
# (injected by Railway) and APPDATA (Windows, to find an `ant auth login` profile).

# scripts/backup_datos.py only: folder to back up and destination of the zip.
# DATOS_DIR=datos
# BACKUP_DESTINO=D:/backups
