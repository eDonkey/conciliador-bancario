# Datos reales de conciliaciones (nunca subir al repo)
datos/*
# excepto los fixtures de demo (datos ficticios, se commitean)
!datos/demo/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Entorno
.env
*.xlsx
*.pdf

# Kit de demo: material GENERADO por scripts/generar_kit_demo.py
# (se regenera solo al arrancar con DEMO_MODE)
static/kit-demo/
# excepto el kit de demo (datos ficticios, se commitean)
!static/kit-demo/*.xlsx
