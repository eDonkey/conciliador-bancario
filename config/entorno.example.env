# Variables del conciliador. Copiá este archivo FUERA del repo, por ejemplo C:\apps\conciladorfbs.env
# (carpeta padre + nombre de la carpeta del conciliador + .env), o dejalo donde quieras y poné su ruta en
# CONCILIADOR_ENV. Formato: NOMBRE=valor, una por línea. Las variables que ya estén en el entorno ganan.
# Después de crearlo, restringí quién lo lee: scripts\restringir_entorno.bat C:\apps\conciladorfbs.env
# Hay que reiniciar el conciliador al cambiarlo.

# Contraseña de acceso directo (sin ella, solo entra la propia máquina o el hub con firma válida)
APP_PASSWORD=cambiame-por-una-contraseña-larga

# Tiene que ser EXACTAMENTE la HUB_CLAVE del hub (44 caracteres, termina en =): firma de identidad del hub
HUB_CLAVE=

# Override temporal del login del FBS con permisos de escritura: AAAA-MM-DD, máximo 60 días desde hoy
FBS_SQL_PERMITIR_LOGIN_ESCRITURA_HASTA=

# Otras (opcionales): SESSION_SECRET, IA_TOKENS_DIA, FBS_SQL_HOSTS_PERMITIDOS, ...
